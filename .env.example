# ==========================================
# BACKEND (Server-only — Never exposed to browser)
# ==========================================
# Database connection
DATABASE_URL="file:./dev.db"
# Production later (PostgreSQL):
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aimhop_erp?schema=public"

# Auth Session Secret
AUTH_SECRET="generate-a-long-random-string"

# Optional Email/SMTP fallback (Settings can also be configured via Admin UI in DB)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="AimHop ERP <your-email@gmail.com>"

# ==========================================
# FRONTEND (Client-safe — Prefixed with NEXT_PUBLIC_)
# ==========================================
NEXT_PUBLIC_APP_NAME="aimhop-ERP"
