# ==========================================
# BACKEND (Server-only — Never exposed to browser)
# ==========================================
# Database connections (PostgreSQL / Supabase)
# DATABASE_URL: Pooled connection (Port 6543 via PgBouncer for runtime app traffic)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:6543/postgres?pgbouncer=true"
# DIRECT_URL: Direct TCP connection (Port 5432 for Prisma migrations and DDL)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres"

# Auth Session Secret
AUTH_SECRET="generate-a-long-random-string"

# Optional Email/SMTP fallback (Settings can also be configured via Admin UI in DB)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="AimHop ERP <your-email@gmail.com>"

# ==========================================
# FRONTEND (Client-safe — Prefixed with NEXT_PUBLIC_)
# ==========================================
NEXT_PUBLIC_APP_NAME="aimhop-ERP"
